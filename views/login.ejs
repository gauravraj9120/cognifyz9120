<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container" style="padding: 4rem 1.5rem; display: flex; justify-content: center; align-items: center; min-height: 75vh;">
  <div class="card" style="max-width: 480px; width: 100%; box-shadow: var(--shadow-lg); border-radius: var(--radius-lg); overflow: hidden;">
    
    <!-- Login Header -->
    <div style="background: var(--gradient-dark); color: #ffffff; padding: 2.5rem 2rem 2rem; text-align: center; position: relative;">
      <div style="width: 64px; height: 64px; margin: 0 auto 12px; background: rgba(99, 102, 241, 0.2); border: 2px solid var(--primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-glow);">
        <img src="/images/logo.png" alt="CodeWithMe9120" style="width: 44px; height: 44px; object-fit: contain;">
      </div>
      <h1 style="color: #ffffff; font-size: 1.6rem; letter-spacing: -0.5px; margin-bottom: 4px;">
        Secure Access Portal
      </h1>
      <p style="color: #94a3b8; font-size: 0.88rem;">
        Role-Based Authentication & Encrypted Session Control
      </p>
    </div>

    <div class="card-body" style="padding: 2.25rem 2rem;">
      
      <!-- Error / Alert Banner -->
      <% if (error) { %>
        <div style="background: #fef2f2; border-left: 4px solid var(--danger); color: #991b1b; padding: 12px 16px; border-radius: var(--radius-sm); font-size: 0.88rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 10px;">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <div><%= error %></div>
        </div>
      <% } %>

      <!-- Success Alert Banner -->
      <% if (successMsg) { %>
        <div style="background: #f0fdf4; border-left: 4px solid var(--success); color: #166534; padding: 12px 16px; border-radius: var(--radius-sm); font-size: 0.88rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 10px;">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <div><%= successMsg %></div>
        </div>
      <% } %>

      <!-- Login Form -->
      <form action="/login" method="POST" autocomplete="off">
        
        <!-- Username or Email -->
        <div class="form-group">
          <label for="identifier">
            Username or Email Address <span class="req-star">*</span>
          </label>
          <div class="input-wrapper">
            <svg class="input-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <input 
              type="text" 
              id="identifier" 
              name="identifier" 
              class="form-control has-icon" 
              placeholder="e.g. admin or gauravrajput9120@gmail.com" 
              value="<%= typeof identifier !== 'undefined' ? identifier : '' %>"
              required 
              autofocus
            >
          </div>
        </div>

        <!-- Password with toggle -->
        <div class="form-group" style="margin-top: 1.2rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <label for="password">
              Password <span class="req-star">*</span>
            </label>
            <button 
              type="button" 
              id="togglePasswordBtn" 
              style="background: none; border: none; font-size: 0.78rem; color: var(--primary); cursor: pointer; font-weight: 600;"
            >
              Show
            </button>
          </div>
          <div class="input-wrapper">
            <svg class="input-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-control has-icon" 
              placeholder="••••••••••••" 
              required
            >
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1.75rem; padding: 0.85rem;">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
          Authenticate & Enter
        </button>
      </form>

      <!-- New Student Sign Up Link -->
      <div style="margin-top: 1.25rem; text-align: center; font-size: 0.88rem; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 1.25rem;">
        New Student? 
        <a href="/register" style="font-weight: 700; color: var(--primary); margin-left: 4px;">Create Student Account (Sign Up) →</a>
      </div>

      <!-- Security Architecture Badges -->
      <div style="margin-top: 2rem; padding: 1.25rem; background: var(--surface-alt); border-radius: var(--radius-md); border: 1px solid var(--border);">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
          <span style="font-size: 0.85rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 6px;">
            🛡️ Security Protocols Active:
          </span>
        </div>
        <ul style="list-style: none; font-size: 0.78rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 4px;">
          <li>🔒 <strong>Bcrypt Salt Hashing</strong>: 10 Salt Rounds</li>
          <li>⏱️ <strong>Rate Limiter</strong>: Max 10 attempts / 15 mins</li>
          <li>🍪 <strong>Session Armor</strong>: HttpOnly + SameSite Strict</li>
          <li>🛡️ <strong>RBAC</strong>: Super Admin & Student Access Control</li>
        </ul>

        <!-- Quick Demo Credentials Box -->
        <div style="margin-top: 12px; padding-top: 10px; border-top: 1px dashed #cbd5e1; font-size: 0.78rem;">
          <span style="font-weight: 700; color: var(--primary);">Quick Credentials (Click to Fill):</span>
          <div style="display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap;">
            <button 
              type="button" 
              onclick="fillCreds('admin', 'AdminSecure@2026')"
              class="btn btn-secondary" 
              style="padding: 4px 8px; font-size: 0.75rem;"
            >
              👑 Super Admin
            </button>
            <button 
              type="button" 
              onclick="fillCreds('student_demo', 'Student@2026')"
              class="btn btn-secondary" 
              style="padding: 4px 8px; font-size: 0.75rem;"
            >
              🎓 Student Demo
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  // Password Visibility Toggle
  const toggleBtn = document.getElementById('togglePasswordBtn');
  const passwordInput = document.getElementById('password');
  if (toggleBtn && passwordInput) {
    toggleBtn.addEventListener('click', () => {
      const isPass = passwordInput.type === 'password';
      passwordInput.type = isPass ? 'text' : 'password';
      toggleBtn.textContent = isPass ? 'Hide' : 'Show';
    });
  }

  // Helper function to fill demo credentials
  function fillCreds(user, pass) {
    document.getElementById('identifier').value = user;
    document.getElementById('password').value = pass;
  }
</script>

<%- include('partials/footer') %>
