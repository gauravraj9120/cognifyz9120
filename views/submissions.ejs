<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container submissions-wrapper">
  <!-- Page Header & Filters -->
  <div class="submissions-header">
    <div>
      <span class="badge-pill">Server-Side Rendered Data</span>
      <h1 style="font-size: 2.2rem; margin-top: 6px;">
        Registered Candidates Directory
      </h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">
        Dynamically populated directly from server memory via EJS template iteration.
      </p>
    </div>

    <!-- Filter & Search Controls -->
    <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
      <form action="/submissions" method="GET" style="display: flex; gap: 6px;">
        <input 
          type="text" 
          name="search" 
          placeholder="Search by name, email, ID..." 
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          class="form-control"
          style="padding: 6px 12px; font-size: 0.85rem; width: 220px;"
        >
        <% if (selectedFilter && selectedFilter !== 'All') { %>
          <input type="hidden" name="trackFilter" value="<%= selectedFilter %>">
        <% } %>
        <button type="submit" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;">Search</button>
      </form>

      <div class="filter-bar">
        <a href="/submissions" class="filter-btn <%= selectedFilter === 'All' ? 'active' : '' %>">All</a>
        <a href="/submissions?trackFilter=Full%20Stack%20Development" class="filter-btn <%= selectedFilter.toLowerCase() === 'full stack development' ? 'active' : '' %>">Full Stack</a>
        <a href="/submissions?trackFilter=Data%20Science%20%26%20ML" class="filter-btn <%= selectedFilter.toLowerCase() === 'data science & ml' ? 'active' : '' %>">Data Science</a>
        <a href="/submissions?trackFilter=Frontend%20Engineering" class="filter-btn <%= selectedFilter.toLowerCase() === 'frontend engineering' ? 'active' : '' %>">Frontend</a>
      </div>

      <a href="/api/export/csv" class="btn btn-secondary" style="padding: 6px 14px; font-size: 0.85rem;" download title="Download CSV for Excel">
        📥 Export CSV
      </a>
    </div>
  </div>

  <!-- Submissions Table -->
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Ref ID</th>
          <th>Student Details</th>
          <th>Domain / Track</th>
          <th>Experience</th>
          <th>Language & Skills</th>
          <th>Timestamp</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (submissions && submissions.length > 0) { %>
          <% submissions.forEach(function(sub) { %>
            <tr>
              <td>
                <span style="font-weight: 700; color: var(--primary); font-family: var(--font-heading);">
                  <%= sub.id %>
                </span>
              </td>
              <td>
                <div class="user-cell">
                  <span class="user-name"><%= sub.fullName %></span>
                  <span class="user-email"><%= sub.email %></span>
                </div>
              </td>
              <td>
                <span class="badge badge-intermediate">
                  <%= sub.track %>
                </span>
              </td>
              <td>
                <span class="badge <%= sub.experience === 'Beginner' ? 'badge-beginner' : (sub.experience === 'Intermediate' ? 'badge-intermediate' : 'badge-advanced') %>">
                  <%= sub.experience %>
                </span>
              </td>
              <td>
                <div style="font-size: 0.85rem; margin-bottom: 4px; font-weight: 600;">
                  <%= sub.preferredLanguage %>
                </div>
                <div class="skills-tags">
                  <% (sub.skills || []).slice(0, 3).forEach(function(skill) { %>
                    <span class="tag" style="font-size: 0.72rem; padding: 2px 6px;"><%= skill %></span>
                  <% }); %>
                  <% if (sub.skills && sub.skills.length > 3) { %>
                    <span class="tag" style="font-size: 0.72rem; padding: 2px 6px;">+<%= sub.skills.length - 3 %></span>
                  <% } %>
                </div>
              </td>
              <td style="color: var(--text-muted); font-size: 0.82rem;">
                <%= sub.submittedAt %>
              </td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 6px; align-items: center;">
                  <a href="/submissions/<%= sub.id %>" class="btn btn-secondary" style="padding: 5px 10px; font-size: 0.8rem;">
                    View
                  </a>
                  <form action="/submissions/<%= sub.id %>/delete" method="POST" onsubmit="return confirm('Delete candidate record <%= sub.id %>?');" style="display:inline; margin:0;">
                    <button type="submit" class="btn btn-secondary" style="padding: 5px 8px; font-size: 0.8rem; color: var(--danger);" title="Delete submission">
                      🗑️
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
              <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="margin: 0 auto 1rem; opacity: 0.4;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
              <h3 style="font-size: 1.1rem; color: var(--text-main); margin-bottom: 4px;">No Submissions Found</h3>
              <p>No records match the current filter or search criteria.</p>
              <a href="/" class="btn btn-primary" style="margin-top: 1rem;">Register Candidate</a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <div style="margin-top: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div style="color: var(--text-muted); font-size: 0.88rem;">
      Showing <strong><%= submissions.length %></strong> of <strong><%= totalCount %></strong> total records in database.
      <span style="margin-left: 10px;">
        <a href="/api/submissions" target="_blank" style="font-size: 0.8rem;">View REST JSON API ↗</a>
      </span>
    </div>
    <div style="display: flex; gap: 10px;">
      <a href="/api/export/csv" class="btn btn-secondary">
        📥 Export CSV
      </a>
      <a href="/" class="btn btn-primary">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        New Registration Form
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
