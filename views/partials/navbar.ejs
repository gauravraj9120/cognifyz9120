<header class="navbar">
  <div class="container nav-container">
    <a href="/" class="brand-logo">
      <img src="/images/logo.png" alt="CodeWithMe9120 Logo" class="brand-img-logo">
      <div class="brand-text">
        <span class="brand-name">CodeWithMe9120</span>
        <span class="brand-tag">Full Stack Development</span>
      </div>
    </a>
    
    <nav>
      <ul class="nav-links">
        <li>
          <a href="/" class="nav-link <%= typeof currentRoute !== 'undefined' && currentRoute === '/' ? 'active' : '' %>">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            Home
          </a>
        </li>
        <li>
          <a href="/submissions" class="nav-link <%= typeof currentRoute !== 'undefined' && currentRoute === '/submissions' ? 'active' : '' %>">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
            Directory
          </a>
        </li>
        
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <!-- Authenticated State -->
          <li>
            <div style="display: flex; align-items: center; gap: 8px; background: rgba(99, 102, 241, 0.08); padding: 4px 12px; border-radius: var(--radius-full); border: 1px solid rgba(99, 102, 241, 0.2);">
              <span class="badge <%= currentUser.role === 'admin' ? 'badge-advanced' : 'badge-beginner' %>" style="font-size: 0.7rem; padding: 2px 6px;">
                <%= currentUser.role.toUpperCase() %>
              </span>
              <span style="font-size: 0.85rem; font-weight: 700; color: var(--text-main);">
                <%= currentUser.username %>
              </span>
            </div>
          </li>
          <li>
            <form action="/logout" method="POST" style="margin: 0;">
              <button type="submit" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.82rem; border-radius: var(--radius-full);">
                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                Logout
              </button>
            </form>
          </li>
        <% } else { %>
          <!-- Guest State -->
          <li>
            <a href="/login" class="btn btn-primary" style="padding: 6px 14px; font-size: 0.82rem; border-radius: var(--radius-full);">
              <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              Admin Portal
            </a>
          </li>
        <% } %>
      </ul>
    </nav>
  </div>
</header>
