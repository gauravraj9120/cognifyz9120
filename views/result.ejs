<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container result-wrapper">
  <div class="result-card">
    <% if (success && data) { %>
      <!-- Successful SSR Header -->
      <div class="result-hero">
        <div class="result-icon">
          <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        </div>
        <h1><%= data.type === 'Registration' ? 'Registration Received!' : 'Message Dispatched!' %></h1>
        <p><%= message %></p>
      </div>

      <!-- SSR Data Table -->
      <div class="result-details">
        <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 1rem; flex-wrap: wrap; gap: 8px;">
          <span style="font-size: 0.85rem; color: var(--text-muted);">
            Submission Reference: <strong style="color: var(--primary);"><%= data.id %></strong>
          </span>
          <div style="display: flex; gap: 6px; align-items: center;">
            <% if (typeof emailNotification !== 'undefined') { %>
              <span class="badge badge-intermediate" title="Sent to <%= emailNotification %>">
                ✉️ Dispatched to <%= emailNotification %>
              </span>
            <% } %>
            <span class="badge badge-beginner">
              Rendered via EJS Engine
            </span>
          </div>
        </div>

        <table class="detail-table">
          <tbody>
            <tr>
              <th>Full Name</th>
              <td><strong><%= data.fullName %></strong></td>
            </tr>
            <tr>
              <th>Email Address</th>
              <td><%= data.email %></td>
            </tr>
            <% if (data.phone) { %>
              <tr>
                <th>Phone</th>
                <td><%= data.phone %></td>
              </tr>
            <% } %>

            <% if (data.track) { %>
              <tr>
                <th>Internship Track</th>
                <td><span class="badge badge-intermediate"><%= data.track %></span></td>
              </tr>
            <% } %>

            <% if (data.experience) { %>
              <tr>
                <th>Experience Level</th>
                <td><%= data.experience %></td>
              </tr>
            <% } %>

            <% if (data.preferredLanguage) { %>
              <tr>
                <th>Primary Language</th>
                <td><%= data.preferredLanguage %></td>
              </tr>
            <% } %>

            <% if (data.skills && data.skills.length > 0) { %>
              <tr>
                <th>Selected Skills</th>
                <td>
                  <div class="skills-tags">
                    <% data.skills.forEach(function(skill) { %>
                      <span class="tag"><%= skill %></span>
                    <% }); %>
                  </div>
                </td>
              </tr>
            <% } %>

            <% if (data.subject) { %>
              <tr>
                <th>Subject</th>
                <td><%= data.subject %></td>
              </tr>
            <% } %>

            <% if (data.inquiryType) { %>
              <tr>
                <th>Inquiry Type</th>
                <td><%= data.inquiryType %></td>
              </tr>
            <% } %>

            <% if (data.projectIdea) { %>
              <tr>
                <th>Project Statement</th>
                <td style="font-style: italic; color: #475569;"><%= data.projectIdea %></td>
              </tr>
            <% } %>

            <% if (data.message) { %>
              <tr>
                <th>Message Content</th>
                <td style="font-style: italic; color: #475569;"><%= data.message %></td>
              </tr>
            <% } %>

            <tr>
              <th>Server Timestamp</th>
              <td style="color: var(--text-muted); font-size: 0.85rem;"><%= data.submittedAt %></td>
            </tr>
          </tbody>
        </table>

        <!-- Navigation Actions -->
        <div class="result-actions">
          <a href="/" class="btn btn-secondary">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Submit Another Form
          </a>
          <a href="/submissions" class="btn btn-primary">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            View All Submissions (SSR)
          </a>
        </div>
      </div>
    <% } else { %>
      <!-- Error State -->
      <div class="result-hero" style="background: #991b1b;">
        <div class="result-icon" style="background: rgba(239, 68, 68, 0.2); border-color: var(--danger); color: white;">
          <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </div>
        <h1>Submission Incomplete</h1>
        <p><%= message %></p>
      </div>
      <div class="result-details" style="text-align: center;">
        <p style="margin-bottom: 2rem; color: var(--text-muted);">
          Please ensure all mandatory fields are provided before submitting to the server.
        </p>
        <a href="/" class="btn btn-primary">Return to Forms</a>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
