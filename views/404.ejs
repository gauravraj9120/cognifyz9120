<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container result-wrapper">
  <div class="result-card" style="text-align: center;">
    <div class="result-hero" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
      <div class="result-icon" style="background: rgba(245, 158, 11, 0.2); border-color: var(--accent); color: var(--accent);">
        <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      </div>
      <h1 style="font-size: 3rem; margin-top: 10px;">404</h1>
      <p style="color: #cbd5e1; font-size: 1.1rem;"><%= typeof message !== 'undefined' ? message : 'The page you are looking for does not exist.' %></p>
    </div>

    <div class="result-details" style="padding: 2.5rem 2rem;">
      <p style="color: var(--text-muted); margin-bottom: 2rem;">
        This 404 response was dynamically generated by the Express.js route error middleware using the EJS template engine.
      </p>
      <a href="/" class="btn btn-primary">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Return to Home Page
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
