<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Hero Section -->
<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div>
        <span class="badge-pill">🚀 Task 1: Level 1 Beginner</span>
        <h1 class="hero-title">
          HTML Structure & <span>Server-Side Interaction</span>
        </h1>
        <p class="hero-desc">
          Explore the core architecture of Full Stack Development: semantic HTML5 forms, Express.js HTTP request routing, and dynamic Server-Side Rendering (SSR) using the EJS templating engine.
        </p>

        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-number"><%= totalSubmissions %></span>
            <span class="stat-label">Active Submissions</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">EJS + Express</span>
            <span class="stat-label">SSR Stack</span>
          </div>
          <div class="stat-item">
            <span class="stat-number"><%= serverTime %></span>
            <span class="stat-label">Server Render Time</span>
          </div>
        </div>
      </div>

      <!-- SSR Architecture Explainer Card -->
      <div class="concept-card">
        <div class="concept-card-header">
          <img src="/images/logo.png" alt="CodeWithMe9120 Emblem" style="width: 50px; height: 50px; object-fit: contain; border-radius: 8px; filter: drop-shadow(0 4px 10px rgba(99, 102, 241, 0.35));">
          <div>
            <h3>Server-Side Rendering (SSR)</h3>
            <span style="font-size: 0.8rem; color: var(--text-muted);">How this page works</span>
          </div>
        </div>
        <ul class="concept-list">
          <li>
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span><strong>Client submits form</strong> via standard HTTP <code>POST</code> method.</span>
          </li>
          <li>
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span><strong>Express parses payload</strong> with <code>express.urlencoded()</code> middleware.</span>
          </li>
          <li>
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span><strong>EJS compiles HTML</strong> dynamically on the server before sending to client.</span>
          </li>
          <li>
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span><strong>Zero client JS needed</strong> for initial render, boosting SEO and speed.</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Main Interactive Forms Section -->
<main class="container main-layout">
  <!-- Left Column: Student Registration Form -->
  <section>
    <div class="card">
      <div class="card-header">
        <h2>
          <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          Internship Student Registration Form
        </h2>
        <p>Complete the form below to submit your details to the Express backend server.</p>
      </div>

      <div class="card-body">
        <form action="/submit-student" method="POST" id="studentForm">
          <div class="form-grid">
            <!-- Full Name -->
            <div class="form-group">
              <label for="fullName">
                Full Name <span class="req-star">*</span>
              </label>
              <div class="input-wrapper">
                <svg class="input-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                <input 
                  type="text" 
                  id="fullName" 
                  name="fullName" 
                  class="form-control has-icon" 
                  placeholder="e.g. Gaurav Rajput" 
                  required
                >
              </div>
            </div>

            <!-- Email Address -->
            <div class="form-group">
              <label for="email">
                Email Address <span class="req-star">*</span>
              </label>
              <div class="input-wrapper">
                <svg class="input-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  class="form-control has-icon" 
                  placeholder="student@example.com" 
                  required
                >
              </div>
            </div>

            <!-- Phone Number -->
            <div class="form-group">
              <label for="phone">Phone Number</label>
              <div class="input-wrapper">
                <svg class="input-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  class="form-control has-icon" 
                  placeholder="+91 98765 43210"
                >
              </div>
            </div>

            <!-- Internship Track Select -->
            <div class="form-group">
              <label for="track">
                Internship Domain / Track <span class="req-star">*</span>
              </label>
              <select id="track" name="track" class="form-control" required>
                <option value="" disabled selected>Select your domain</option>
                <option value="Full Stack Development">Full Stack Development</option>
                <option value="Data Science & ML">Data Science & ML</option>
                <option value="Frontend Engineering">Frontend Engineering</option>
                <option value="Backend Development">Backend Development</option>
              </select>
            </div>

            <!-- Experience Level (Radio Group) -->
            <div class="form-group form-full">
              <label>Current Experience Level</label>
              <div class="radio-group">
                <label class="custom-choice">
                  <input type="radio" name="experience" value="Beginner" checked>
                  <span>Beginner (Level 1)</span>
                </label>
                <label class="custom-choice">
                  <input type="radio" name="experience" value="Intermediate">
                  <span>Intermediate (Level 2)</span>
                </label>
                <label class="custom-choice">
                  <input type="radio" name="experience" value="Advanced">
                  <span>Advanced (Level 3-4)</span>
                </label>
              </div>
            </div>

            <!-- Primary Language (Radio Group) -->
            <div class="form-group form-full">
              <label>Primary Backend Language</label>
              <div class="radio-group">
                <label class="custom-choice">
                  <input type="radio" name="preferredLanguage" value="JavaScript" checked>
                  <span>JavaScript (Node.js)</span>
                </label>
                <label class="custom-choice">
                  <input type="radio" name="preferredLanguage" value="Python">
                  <span>Python</span>
                </label>
                <label class="custom-choice">
                  <input type="radio" name="preferredLanguage" value="Java">
                  <span>Java</span>
                </label>
                <label class="custom-choice">
                  <input type="radio" name="preferredLanguage" value="PHP">
                  <span>PHP</span>
                </label>
              </div>
            </div>

            <!-- Technical Skills (Checkbox Group) -->
            <div class="form-group form-full">
              <label>Technical Skills & Proficiencies</label>
              <div class="checkbox-group">
                <label class="custom-choice">
                  <input type="checkbox" name="skills" value="HTML5" checked>
                  <span>HTML5</span>
                </label>
                <label class="custom-choice">
                  <input type="checkbox" name="skills" value="CSS3" checked>
                  <span>CSS3</span>
                </label>
                <label class="custom-choice">
                  <input type="checkbox" name="skills" value="JavaScript" checked>
                  <span>JavaScript</span>
                </label>
                <label class="custom-choice">
                  <input type="checkbox" name="skills" value="Node.js" checked>
                  <span>Node.js</span>
                </label>
                <label class="custom-choice">
                  <input type="checkbox" name="skills" value="Express">
                  <span>Express.js</span>
                </label>
                <label class="custom-choice">
                  <input type="checkbox" name="skills" value="EJS Templates">
                  <span>EJS SSR</span>
                </label>
              </div>
            </div>

            <!-- Project Idea Textarea -->
            <div class="form-group form-full">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <label for="projectIdea">Proposed Project Idea / Motivation</label>
                <span id="charCount" style="font-size: 0.75rem; color: var(--text-muted);">0/500</span>
              </div>
              <textarea 
                id="projectIdea" 
                name="projectIdea" 
                class="form-control" 
                maxlength="500"
                placeholder="Briefly describe what you'd love to build during this internship..."
              ></textarea>
            </div>
          </div>

          <div style="margin-top: 1.5rem; display: flex; gap: 1rem; align-items: center;">
            <button type="submit" class="btn btn-primary" id="submitBtn">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              Submit Form via HTTP POST
            </button>
            <button type="reset" class="btn btn-secondary">
              Reset Form
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Right Column: Quick Poll & Contact Forms -->
  <aside>
    <!-- Quick Interactive SSR Poll Card -->
    <div class="card side-card">
      <div class="card-header">
        <h2 style="font-size: 1.15rem;">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          Quick SSR Concept Check
        </h2>
        <p>Why use Server-Side Rendering (SSR)?</p>
      </div>
      <div class="card-body">
        <form id="quickPollForm">
          <div style="display: flex; flex-direction: column; gap: 8px;">
            <label class="custom-choice">
              <input type="radio" name="ssrKnowledge" value="Fast initial page loads & SEO benefits" checked>
              <span>Fast initial page loads & SEO benefits</span>
            </label>
            <label class="custom-choice">
              <input type="radio" name="ssrKnowledge" value="Dynamic HTML generation on the server">
              <span>Dynamic HTML generation on server</span>
            </label>
            <label class="custom-choice">
              <input type="radio" name="ssrKnowledge" value="Secure credential handling & validation">
              <span>Secure backend data processing</span>
            </label>
          </div>
          <button type="submit" class="btn btn-secondary btn-block" style="margin-top: 12px;">
            Submit Quick Vote
          </button>
          <div id="pollResult"></div>
        </form>
      </div>
    </div>

    <!-- Contact & Query Form -->
    <div class="card side-card" id="contactSection">
      <div class="card-header">
        <h2 style="font-size: 1.15rem;">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          Contact / Support Form
        </h2>
        <p>Send a message directly to server endpoint <code>/submit-contact</code></p>
      </div>
      <div class="card-body">
        <form action="/submit-contact" method="POST">
          <div class="form-group">
            <label for="contactName">Name <span class="req-star">*</span></label>
            <input type="text" id="contactName" name="contactName" class="form-control" placeholder="Your Name" required>
          </div>

          <div class="form-group">
            <label for="contactEmail">Email <span class="req-star">*</span></label>
            <input type="email" id="contactEmail" name="contactEmail" class="form-control" placeholder="you@domain.com" required>
          </div>

          <div class="form-group">
            <label for="inquiryType">Inquiry Type</label>
            <select id="inquiryType" name="inquiryType" class="form-control">
              <option value="Internship Support">Internship Support</option>
              <option value="Task 1 Guidance">Task 1 Guidance</option>
              <option value="Certificate Verification">Certificate Verification</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Message <span class="req-star">*</span></label>
            <textarea id="message" name="message" class="form-control" rows="3" placeholder="How can we assist you?" required></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Send Message
          </button>
        </form>
      </div>
    </div>
  </aside>
</main>

<%- include('partials/footer') %>
